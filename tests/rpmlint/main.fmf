/prepare:
  # TODO: This can be skipped when using tmt artifacts
  # TODO: Move this to somewhere more central
  summary: Get the artifacts and configuration
  duration: 30m
  order: 40
  require:
    - koji
    - git
    - python3-ruamel-yaml
    - python3-tomli-w
  test: python3 ./prepare.py

/run-rpmlint:
  summary: Run rpmlint
  # TODO: How to split this duration between environment preparation and actual execution?
  duration: 30m
  require+:
    - rpmlint
    - rpmlint-fedora-license-data
    # workaround for https://src.fedoraproject.org/rpms/rpmlint/pull-request/59
    - glibc-langpack-en
  test: python3 ./run-rpmlint.py
