/prepare:
  # TODO: This can be skipped when using tmt artifacts
  # TODO: Move this to somewhere more central
  summary: Get the artifacts and configuration
  duration: 30m
  order: 40
  require:
    - koji
    - git
    - python3-ruamel-yaml
    - python3-tomli-w
  test: python3 ./prepare.py

/run-fedora-review:
  summary: Run fedora-review
  duration: 30m
  description: |
    Requires having some environment variables predefined.
    See documentation of the run-fedora-review script.
  require:
    - fedora-review
  test: python3 ./run-fedora-review.py
  result: custom
